#!/usr/bin/env bash
# sw-gate — agent-free gate of the hourly sw-sweep workflow.
#
# Prints the health line from sw-doctor and exactly one decision line:
#   URUCHOM: NIC          nothing to start in this cycle
#   URUCHOM: GENERATOR    no active project: generate an idea
#   URUCHOM: OCENA <nr>   idea <nr> is "sw-w-ocenie" but its evaluation task is lost
# Before "URUCHOM: GENERATOR" it writes .ai/sw-run/generator.json (SW_RUN_DIR) in the
# working directory: {"odrzucone": [{numer, tytul, problem, wskazowki: [..]}]}.
# Further decisions (URUCHOM: SPEC, ...) are added by later implementation
# steps; see the technical sections of the spec.
#
# Cycle counters, restart-proof because they live in the journal ("sw-dziennik"):
#   - consecutive "STAN: BLAD" cycles: each is logged; after
#     "noIdeaNotifyAfterCycles" of them in a row one "blocked" notification is
#     sent; the first healthy cycle after a failure logs "STAN: OK";
#   - consecutive "brak pomysłu" entries since the newest idea card: when the
#     cycle is about to generate and the count reached "noIdeaNotifyAfterCycles",
#     one "blocked" notification with a link to the journal is sent.
# A "powiadomienie: ..." journal entry marks a sent notification (deduplication).
#
# Active project: open "sw-pomysl" issue in the control repository that is
# "sw-w-ocenie", "sw-zatwierdzony" or has a "sw-stan-*" label other than
# "sw-stan-wdrozony" / "sw-stan-wstrzymany". Projects already handed over to the
# sh-* chain (repository with .ai/cezar/workflows/sh-delivery.yml) are left
# alone. Apart from the journal entries above and generator.json it changes nothing.
# Exit code 0 when the gate ran on a healthy runtime, 1 otherwise.
set -uo pipefail

here="$(dirname "$0")"
# shellcheck source=bin/lib/common.sh
. "$here/lib/common.sh"

control="$(jq -r '.controlRepo // empty' "$SW_CONFIG" 2>/dev/null)"
control_name="${control#*/}"
notify_after="$(jq -r '.noIdeaNotifyAfterCycles // 24' "$SW_CONFIG" 2>/dev/null)"
[[ "$notify_after" =~ ^[0-9]+$ ]] && [ "$notify_after" -gt 0 ] || notify_after=24

# journal_notify <marker> <title> — one "blocked" notification linking the journal,
# then a marker entry so the next cycles stay silent. Best effort: a failure here
# never changes the decision of the gate.
journal_notify() {
  local url="https://github.com/$control/issues/$journal"
  if "$here/sw-notify" blocked "$control" "$journal" "$2" "$url" 2>/dev/null | grep -qx 'WYNIK: WYSLANO'; then
    "$here/sw-log" "powiadomienie: $1" >/dev/null 2>&1 || sw_log "bramka: nie mozna zapisac znacznika powiadomienia"
  fi
}

# journal_load — sets $journal and $comments (JSON array); status 1 when unavailable.
journal_load() {
  [ -n "$control" ] || return 1
  journal="$(sw_journal_issue)" && [ -n "$journal" ] || return 1
  comments="$(sw_journal_comments "$journal")" && [ -n "$comments" ] || return 1
}

# Failure cycle: log the STAN: BLAD line and count the failures in a row.
note_failure() {
  "$here/sw-log" "$1" >/dev/null 2>&1 || { sw_log "bramka: nie mozna zapisac w dzienniku"; return 0; }
  journal_load || return 0
  local streak
  streak="$(printf '%s' "$comments" | jq -c '
    map(if (.body | startswith("STAN: BLAD")) then "blad"
        elif (.body | startswith("powiadomienie: STAN: BLAD")) then "marker"
        else "other" end) as $k
    | ([range(0; $k | length) | select($k[.] == "other")] | last // -1) as $b
    | $k[$b + 1:] | {count: map(select(. == "blad")) | length, notified: (index("marker") != null)}')"
  if [ "$(printf '%s' "$streak" | jq '.count')" -ge "$notify_after" ] \
    && [ "$(printf '%s' "$streak" | jq '.notified')" = false ]; then
    journal_notify "STAN: BLAD" "Blad srodowiska: $notify_after cykli z rzedu"
  fi
}

# Healthy cycle after failures: close the streak in the journal.
note_recovery() {
  journal_load || return 0
  if printf '%s' "$comments" | jq -e '
      map(select(.body | startswith("powiadomienie: ") | not)) | last.body // "" | startswith("STAN: BLAD")' >/dev/null; then
    "$here/sw-log" "STAN: OK" >/dev/null 2>&1 || sw_log "bramka: nie mozna zapisac w dzienniku"
  fi
}

health="$("$here/sw-doctor")"
doctor_status=$?
[ -z "$health" ] || printf '%s\n' "$health"
if [ "$doctor_status" -ne 0 ]; then
  note_failure "$(printf '%s\n' "$health" | grep '^STAN: BLAD' | head -1)"
  echo "URUCHOM: NIC"
  exit 1
fi
note_recovery

# Cezar project id of the control repository (health lists projects by name).
project_id="$(curl -fsS --max-time 10 "$SW_CEZAR_URL/api/v1/health" 2>/dev/null \
  | jq -r --arg n "$control_name" '[.projects[]? | select(.name == $n) | .id][0] // empty' 2>/dev/null)"
project_id="${project_id:-${CEZ_PROJECT_ID:-}}"

# cezar_get <path> — body on stdout; status 0 = ok, 1 = missing (404), 2 = other failure.
cezar_get() {
  local out code
  out="$(curl -sS --max-time 10 -w '\n%{http_code}' "$SW_CEZAR_URL$1" 2>/dev/null)" || return 2
  code="${out##*$'\n'}"
  case "$code" in
    200) printf '%s' "${out%$'\n'*}" ;;
    404) return 1 ;;
    *) return 2 ;;
  esac
}

# Without a verifiable picture of the cycle the safe decision is to wait.
undecided() {
  sw_log "bramka: $1"
  echo "URUCHOM: NIC"
  exit 0
}

[ -n "$project_id" ] || undecided "brak projektu $control_name w Cezarze"
[ -n "$control" ] || undecided "brak controlRepo w konfiguracji"

# Mutual exclusion: another queued/running sw-sweep (not this one) wins.
runs="$(cezar_get "/api/v1/p/$project_id/runs")" || undecided "nie mozna odczytac zadan Cezara"
other="$(printf '%s' "$runs" | jq -r --arg me "${CEZ_RUN_ID:-}" '
  (if type == "array" then . else (.runs // []) end)
  | map(select(.workflow == "sw-sweep" and (.status == "queued" or .status == "running") and .id != $me))
  | length' 2>/dev/null)" || undecided "niepoprawna lista zadan Cezara"
if [ "${other:-0}" -gt 0 ]; then
  echo "URUCHOM: NIC"
  exit 0
fi

issues="$(gh api --paginate "repos/$control/issues?labels=sw-pomysl&state=open&per_page=100" 2>/dev/null)" \
  || undecided "nie mozna odczytac issues $control"
issues="$(printf '%s' "$issues" | jq -c '
  [.[]? | select(.pull_request == null)
        | {number, labels: [.labels[].name],
           meta: ((.body // "") | capture("<!-- sw:meta (?<j>\\{.*\\}) -->"; "m").j? // "{}" | (try fromjson catch {}))}
        | select(any(.labels[]; . == "sw-w-ocenie" or . == "sw-zatwierdzony"
              or (startswith("sw-stan-") and . != "sw-stan-wdrozony" and . != "sw-stan-wstrzymany")))]' 2>/dev/null)" \
  || undecided "niepoprawna lista issues"

# Idea generation is about to run: count the "brak pomysłu" entries since the
# newest card and notify once when they reach the limit.
note_no_idea() {
  journal_load || return 0
  local cards since state
  cards="$(gh api --paginate "repos/$control/issues?labels=sw-pomysl&state=all&per_page=100" 2>/dev/null)" || return 0
  since="$(printf '%s' "$cards" | jq -s '[.[] | (if type == "array" then .[] else . end) | select(.pull_request == null) | .created_at // empty] | max // ""')"
  state="$(printf '%s' "$comments" | jq -c --argjson since "$since" '
    map(select(.created_at > $since)) as $c
    | {count: ($c | map(select(.body | startswith("brak pomysłu"))) | length),
       notified: ($c | any(.body | startswith("powiadomienie: brak pomysłu")))}')"
  if [ "$(printf '%s' "$state" | jq '.count')" -ge "$notify_after" ] \
    && [ "$(printf '%s' "$state" | jq '.notified')" = false ]; then
    journal_notify "brak pomysłu" "Brak pomysłów: $notify_after cykli z rzedu"
  fi
}

active=0
lost=""
while IFS= read -r issue; do
  [ -n "$issue" ] || continue
  number="$(printf '%s' "$issue" | jq -r .number)"
  repo="$(printf '%s' "$issue" | jq -r '.meta.repo // empty')"
  if [ -n "$repo" ] && gh api "repos/$repo/contents/.ai/cezar/workflows/sh-delivery.yml" >/dev/null 2>&1; then
    continue # sh-* project: not ours
  fi
  active=$((active + 1))
  if printf '%s' "$issue" | jq -e '.labels | index("sw-w-ocenie")' >/dev/null; then
    eval_id="$(printf '%s' "$issue" | jq -r '.meta.evalRunId // empty')"
    if [ -z "$eval_id" ]; then
      state=lost
    else
      body="$(cezar_get "/api/v1/p/$project_id/runs/$eval_id")"
      case $? in
        0) state="$(printf '%s' "$body" | jq -r '.status // "unknown"')" ;;
        1) state=lost ;;
        *) undecided "nie mozna odczytac zadania oceny $eval_id" ;;
      esac
    fi
    case "$state" in
      waiting|running|queued) ;;
      *) [ -n "$lost" ] || lost="$number" ;;
    esac
  fi
done < <(printf '%s' "$issues" | jq -c 'sort_by(.number)[]')

if [ -n "$lost" ]; then
  echo "URUCHOM: OCENA $lost"
elif [ "$active" -gt 0 ]; then
  echo "URUCHOM: NIC"
else
  # The generator gets the rejected ideas and the owner's hints (spec S1, S3).
  rejected="$(sw_rejected_ideas)" || undecided "nie mozna odczytac odrzuconych pomyslow"
  run_dir="${SW_RUN_DIR:-.ai/sw-run}"
  if ! { mkdir -p "$run_dir" && jq -n --argjson r "$rejected" '{odrzucone: $r}' > "$run_dir/generator.json"; }; then
    undecided "nie mozna zapisac $run_dir/generator.json"
  fi
  note_no_idea
  echo "URUCHOM: GENERATOR"
fi
