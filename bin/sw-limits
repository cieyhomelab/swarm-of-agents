#!/usr/bin/env bash
# sw-limits [<nr>] — checks the time and usage limits of the project of idea issue <nr>
# (spec S12) and pauses it through sw-pause when one is exceeded.
#   - time: "approvedAt" from the issue metadata + "projectTimeLimitHours" (config);
#   - usage: sum of "costUsd" of the tasks of the project's Cezar project ("projectId"
#     in the metadata, GET /api/v1/p/{id}/runs) against "projectUsageLimitUsd".
# Without <nr> the idea is read from the README of the checkout in the working directory
# (sw-create-repo seeds it), so the sw-build workflow calls it without arguments.
# Only an active project is checked (open, "sw-zatwierdzony" or a "sw-stan-*" label other
# than "sw-stan-wdrozony" / "sw-stan-wstrzymany"). SW_NOW (ISO) overrides the clock in tests.
# Then the tasks of the project are supervised (spec S11, S12; bin/lib/sw_runs.py):
#   - a task waiting for the plan limit ("autoResumeAt") puts "sw-czeka-na-limit" on the idea,
#     retries are neither used nor started, and the label goes when the wait is over;
#   - a task that failed after Cezar's automatic resumes ("cezarAutoResumes", 12) gets a new
#     task from the interrupted step, without using a retry;
#   - a failed task, or one without a commit and a state change for "stalledAfterHours", is
#     retried ("retriesPerTask") in a new task, after the old one is cancelled
#     (POST …/runs/{id}/cancel; when that fails nothing is started; a task cancelled by sw-limits (recorded in
#     SW_STATE_DIR/limits-stopped before the call) that nobody replaced, e.g. when creating the new one failed, is retried in the next cycle); when retries run out the project is paused with
#     the cause and the last state.
# Before anything is assigned, a variable billed outside the plan (API keys, gateways, cloud
# providers; the list of sw-doctor) blocks it: nothing starts and the journal gets an entry.
# Output: WYNIK: OK | WYNIK: WSTRZYMANY <powód> | WYNIK: POMINIETO <powód> |
# WYNIK: CZEKA-NA-LIMIT | WYNIK: ZABLOKOWANY <zmienne>;
# STAN: BLAD <powód> with exit 1 when GitHub or Cezar cannot be read or the pause failed.
set -uo pipefail

here="$(dirname "$0")"
# shellcheck source=bin/lib/common.sh
. "$here/lib/common.sh"
sw_require gh jq curl python3

fail() { echo "STAN: BLAD $*"; exit 1; }

control="$(jq -er '.controlRepo // empty' "$SW_CONFIG")" || fail "brak controlRepo w konfiguracji"
if [ $# -eq 0 ]; then
  [ -r README.md ] || fail "brak numeru pomyslu i README.md z linkiem"
  link="$(grep -oE "https://github\.com/${control//./\\.}/issues/[0-9]+" README.md | head -1)" || true
  [ -n "$link" ] || fail "README.md nie ma linku do pomyslu w $control"
  set -- "${link##*/}"
fi
[[ $# -eq 1 && "${1:-}" =~ ^[0-9]+$ ]] || sw_die "uzycie: sw-limits [<nr>]"
number="$1"

time_limit="$(jq -er '.projectTimeLimitHours // 168' "$SW_CONFIG")" || fail "niepoprawny projectTimeLimitHours"
usage_limit="$(jq -er '.projectUsageLimitUsd // 150' "$SW_CONFIG")" || fail "niepoprawny projectUsageLimitUsd"

issue="$(gh api "repos/$control/issues/$number" 2>/dev/null)" || fail "nie mozna odczytac issue $control#$number"
if ! printf '%s' "$issue" | jq -e '(.state // "open") == "open" and any(.labels[]?; .name == "sw-pomysl")
    and any(.labels[]?; .name == "sw-zatwierdzony" or (.name | startswith("sw-stan-")))
    and (any(.labels[]?; .name == "sw-stan-wstrzymany" or .name == "sw-stan-wdrozony") | not)' >/dev/null; then
  echo "WYNIK: POMINIETO issue $number nie jest aktywnym projektem"
  exit 0
fi
# Paid usage is never switched on: variables billed outside the plan stop every assignment.
billed=""
for var in ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL \
           CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX CLAUDE_CODE_USE_FOUNDRY; do
  [ -z "${!var:-}" ] || billed="${billed:+$billed }$var"
done
if [ -n "$billed" ]; then
  "$here/sw-log" "zadanie nie wystartowało: ustawione zmienne rozliczane poza planem ($billed), projekt #$number" >/dev/null \
    || sw_log "nie mozna zapisac blokady zmiennych w dzienniku"
  echo "WYNIK: ZABLOKOWANY zmienne rozliczane poza planem: $billed"
  exit 0
fi

meta="$(printf '%s' "$issue" | jq -r '.body // ""' \
  | jq -Rs 'capture("<!-- sw:meta (?<j>\\{.*\\}) -->"; "m").j? // "{}" | (try fromjson catch {})')" \
  || fail "niepoprawne metadane issue $number"
approved="$(jq -r '.approvedAt // "-"' <<<"$meta")"
project_id="$(jq -r '.projectId // empty' <<<"$meta")"

usage=0
runs_list="[]"
if [ -n "$project_id" ]; then
  [[ "$project_id" =~ ^[A-Za-z0-9._-]+$ ]] || fail "niepoprawny projectId w metadanych issue $number"
  runs="$(curl -fsS --max-time 10 "$SW_CEZAR_URL/api/v1/p/$project_id/runs" 2>/dev/null)" \
    || fail "nie mozna odczytac zadan projektu $project_id"
  runs_list="$(printf '%s' "$runs" | jq -ec 'if type == "array" then . else (.runs // []) end')" \
    || fail "niepoprawna lista zadan projektu $project_id"
  usage="$(printf '%s' "$runs_list" | jq -er 'map(.costUsd // 0 | numbers) | add // 0')" \
    || fail "niepoprawna lista zadan projektu $project_id"
fi

# journal <text> — a best-effort journal entry; a failure never changes the decision.
journal() { "$here/sw-log" "$1" >/dev/null || sw_log "nie mozna zapisac w dzienniku: $1"; }

# pause_project <reason> — pauses the idea through sw-pause; prints the final WYNIK line.
pause_project() {
  local out
  out="$("$here/sw-pause" "$number" "$1")" || { printf '%s\n' "$out"; return 1; }
  case "$out" in
    "WYNIK: WSTRZYMANY") echo "WYNIK: WSTRZYMANY $1" ;;
    *) printf '%s\n' "$out" ;;
  esac
}

# set_wait_label <yes|no> — adds or drops "sw-czeka-na-limit" after a fresh read (idempotent).
set_wait_label() {
  local fresh labels
  fresh="$(gh api "repos/$control/issues/$number" 2>/dev/null)" || fail "nie mozna odczytac issue $control#$number"
  if [ "$1" = yes ]; then
    printf '%s' "$fresh" | jq -e 'any(.labels[]?; .name == "sw-czeka-na-limit")' >/dev/null && return 0
    labels="$(printf '%s' "$fresh" | jq -c '[.labels[].name] + ["sw-czeka-na-limit"] | unique')"
  else
    printf '%s' "$fresh" | jq -e 'any(.labels[]?; .name == "sw-czeka-na-limit")' >/dev/null || return 0
    labels="$(printf '%s' "$fresh" | jq -c '[.labels[].name | select(. != "sw-czeka-na-limit")]')"
  fi
  jq -nc --argjson l "$labels" '{labels: $l}' | gh api -X PATCH "repos/$control/issues/$number" --input - >/dev/null 2>&1 \
    || fail "nie mozna zmienic etykiet issue $number"
  if [ "$1" = yes ]; then journal "czeka na limit planu: pomysł #$number"; else journal "limit planu odnowiony: pomysł #$number"; fi
}

# supervise — plan limit label, retries and stalled tasks of the project (bin/lib/sw_runs.py).
supervise() {
  local progress="{}" stopped stopped_file="${SW_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/swarm-of-agents}/limits-stopped" repo stalled retries resumes plan wait id branch when action kind
  repo="$(jq -r '.repo // empty' <<<"$meta")"
  stalled="$(jq -er '.stalledAfterHours // 3' "$SW_CONFIG")" || fail "niepoprawny stalledAfterHours"
  retries="$(jq -er '.retriesPerTask // 2' "$SW_CONFIG")" || fail "niepoprawny retriesPerTask"
  resumes="$(jq -er '.cezarAutoResumes // 12' "$SW_CONFIG")" || fail "niepoprawny cezarAutoResumes"
  if [ -n "$repo" ]; then
    while IFS=$'\t' read -r id branch; do
      [[ "$branch" =~ ^[A-Za-z0-9._/-]+$ ]] || continue
      when="$(gh api "repos/$repo/commits?sha=$branch&per_page=1" 2>/dev/null | jq -r '.[0].commit.committer.date // empty')" || when=""
      [ -z "$when" ] || progress="$(jq -c --arg i "$id" --arg w "$when" '. + {($i): $w}' <<<"$progress")"
    done < <(jq -r '.[] | select(.branch and (.status == "running" or .status == "waiting")) | [.id, .branch] | @tsv' <<<"$runs_list")
  fi
  stopped="$(jq -Rsc 'split("\n") | map(select(length > 0))' "$stopped_file" 2>/dev/null)" || stopped="[]"
  [ -n "$stopped" ] || stopped="[]"
  plan="$(jq -nc --argjson r "$runs_list" --arg n "$now" --argjson s "$stalled" --argjson t "$retries" \
      --argjson a "$resumes" --argjson p "$progress" --argjson c "$stopped" \
      '{runs: $r, now: $n, stalledAfterHours: $s, retriesPerTask: $t, autoResumeLimit: $a, progress: $p, stoppedByLimits: $c}' \
    | python3 "$here/lib/sw_runs.py")" || fail "nie mozna sprawdzic zadan projektu $number"
  wait="$(jq -r '.planWait' <<<"$plan")"
  if [ "$wait" = true ]; then
    set_wait_label yes
    echo "WYNIK: CZEKA-NA-LIMIT"
    return 0
  fi
  set_wait_label no
  while IFS= read -r action; do
    [ -n "$action" ] || continue
    kind="$(jq -r .kind <<<"$action")"
    if [ "$kind" = exhausted ]; then
      pause_project "$(jq -r .reason <<<"$action")"
      return $?
    fi
    # A stalled task is still active: cancel it first, so two tasks never share one branch.
    # The id is recorded first: a cancelled task that is not on that list was stopped by hand.
    if [ "$(jq -r '.stop // false' <<<"$action")" = true ]; then
      { mkdir -p "$(dirname "$stopped_file")" && jq -r .run <<<"$action" >>"$stopped_file"; } \
        || fail "nie mozna zapisac znacznika zatrzymania zadania $(jq -r .run <<<"$action")"
      curl -fsS --max-time 10 -X POST "$SW_CEZAR_URL/api/v1/p/$project_id/runs/$(jq -r .run <<<"$action")/cancel" >/dev/null 2>&1 \
        || fail "nie mozna zatrzymac zadania $(jq -r .run <<<"$action"); ponowienie wstrzymane"
    fi
    jq -c '{task, workflow, autonomous: true} + (if .model != "" then {model} else {} end)' <<<"$action" \
      | curl -fsS --max-time 10 -X POST -H 'Content-Type: application/json' --data-binary @- \
          "$SW_CEZAR_URL/api/v1/p/$project_id/runs" >/dev/null 2>&1 \
      || fail "nie mozna utworzyc zadania ($kind) dla $(jq -r .run <<<"$action")"
    journal "$(case "$kind" in resume) echo wznowienie;; *) echo ponowienie;; esac): pomysł #$number: $(jq -r .reason <<<"$action")"
  done < <(jq -c '.actions[]' <<<"$plan")
  echo "WYNIK: OK"
}

now="${SW_NOW:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}"
reason="$(python3 "$here/lib/sw_limits.py" "$approved" "$now" "$time_limit" "$usage" "$usage_limit")" \
  || fail "nie mozna sprawdzic limitow projektu $number"
if [ -z "$reason" ]; then
  supervise
  exit $?
fi

pause_project "$reason"
