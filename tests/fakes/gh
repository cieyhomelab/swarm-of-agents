#!/usr/bin/env bash
# Fake GitHub CLI for tests. Supports `gh pr ready <n> --repo <o/r>` and `gh api [-X METHOD] [--paginate]
# [--input -] PATH [--jq EXPR]` by forwarding to the mock API at
# $FAKE_GH_API_URL. Anything else fails.
set -euo pipefail

if [ "${1:-}" = "pr" ] && [ "${2:-}" = "ready" ]; then
  # gh pr ready <n> --repo <o/r>
  curl -fsS -X POST "${FAKE_GH_API_URL:?}/github/repos/${5:?}/pulls/${3:?}/ready" >/dev/null
  exit $?
fi
[ "${1:-}" = "api" ] || { echo "fake gh: unsupported command: $*" >&2; exit 2; }
shift

method=""
path=""
jq_expr=""
input=0
while [ $# -gt 0 ]; do
  case "$1" in
    -X|--method) method="$2"; shift 2 ;;
    --jq|-q) jq_expr="$2"; shift 2 ;;
    --input) [ "$2" = "-" ] || { echo "fake gh: only --input - is supported" >&2; exit 2; }; input=1; shift 2 ;;
    --paginate) shift ;;
    -*) echo "fake gh: unsupported flag: $1" >&2; exit 2 ;;
    *) path="$1"; shift ;;
  esac
done
[ -n "$method" ] || { [ "$input" -eq 1 ] && method=POST || method=GET; }

: "${FAKE_GH_API_URL:?fake gh: FAKE_GH_API_URL not set}"
curl_args=(-fsS -X "$method")
[ "$input" -eq 1 ] && curl_args+=(-H 'Content-Type: application/json' --data-binary @-)
body="$(curl "${curl_args[@]}" "$FAKE_GH_API_URL/github/${path#/}")" || exit 1
if [ -n "$jq_expr" ]; then
  printf '%s' "$body" | jq -r "$jq_expr"
else
  printf '%s\n' "$body"
fi
