# Zmienne środowiskowe swarm-of-agents. W repozytorium nigdy nie ma prawdziwych wartości.
# Oznaczenia: [VPS] potrzebna tylko produkcyjnie, [TESTY] ustawiana przez testy,
# [ZABRONIONA] nie może być ustawiona.

# [VPS] Adres API Cezara. Opcjonalna; domyślnie http://127.0.0.1:4321.
# [TESTY] compose.yml ustawia ją na atrapę (http://mock:8080).
SW_CEZAR_URL=http://127.0.0.1:4321

# [VPS] Katalog klonu swarm-of-agents. Opcjonalna; domyślnie $HOME/swarm-of-agents.
SW_HOME=

# [VPS] Ścieżka konfiguracji. Opcjonalna; domyślnie $SW_HOME/config/sw.json.
SW_CONFIG=

# [VPS] Plik z tokenem bramki powiadomień cezar-push. Opcjonalna; domyślnie
# ~/.cezar-push/gate-token (plik już istnieje na VPS). Używana od etapu 1.
SW_PUSH_TOKEN_FILE=

# [TESTY] Adres atrapy GitHub API dla tests/fakes/gh. Ustawiany przez testy.
FAKE_GH_API_URL=

# [TESTY] Identyfikator przebiegu E2E (nazwa projektu Compose e2e-<id>). Opcjonalna.
E2E_RUN_ID=

# [ZABRONIONA] ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN, ANTHROPIC_BASE_URL,
# CLAUDE_CODE_USE_BEDROCK, CLAUDE_CODE_USE_VERTEX, CLAUDE_CODE_USE_FOUNDRY.
# Modele działają wyłącznie na planie Claude Max; bin/sw-doctor zgłasza błąd.
