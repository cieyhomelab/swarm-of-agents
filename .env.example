# Zmienne środowiskowe swarm-of-agents. Na VPS ustawiane w środowisku procesu Cezara
# albo w pliku sekretów; w repozytorium nigdy nie ma prawdziwych wartości.

# Adres API Cezara na VPS. Opcjonalna; domyślnie http://127.0.0.1:4322.
SW_CEZAR_URL=http://127.0.0.1:4322

# Katalog klonu swarm-of-agents na VPS. Opcjonalna; domyślnie $HOME/swarm-of-agents.
SW_HOME=

# Ścieżka konfiguracji. Opcjonalna; domyślnie $SW_HOME/config/sw.json.
SW_CONFIG=

# Token bramki powiadomień cezar-push. Wymagany od etapu 1 (powiadomienie
# „specyfikacja gotowa”); skrypty czytają go z ~/.cezar-push/gate-token,
# więc zmienna jest potrzebna tylko, gdy plik leży gdzie indziej.
SW_PUSH_TOKEN_FILE=

# ZABRONIONE: ANTHROPIC_API_KEY. Modele działają wyłącznie na planie Claude Max;
# bin/sw-doctor zgłasza błąd, gdy ta zmienna jest ustawiona.
